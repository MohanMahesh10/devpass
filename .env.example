# ---- Azure Storage (Table Storage) ----
AZURE_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net

# ---- Azure Communication Services (Email) ----
ACS_CONNECTION_STRING=endpoint=https://<your-acs>.communication.azure.com/;accesskey=...
ACS_SENDER_EMAIL=DoNotReply@devpass.azurecomm.net

# ---- Admin auth ----
ADMIN_PASSWORD=change-me-please
SESSION_SECRET=some-long-random-string

# ---- Event details ----
EVENT_ID=devpass-2025
EVENT_NAME=DevPass 2025
EVENT_DATE=2025-08-15
EVENT_VENUE=Your Venue Here

# ---- Server ----
PORT=3001
# Comma-separated list of allowed origins for CORS (e.g. your Static Web App URL)
CLIENT_ORIGIN=http://localhost:3000

# ---- AI Agent (optional) ----
# The agentic registration pipeline (services/agentPipeline.js) ships with a
# deterministic JS stub and works WITHOUT this key.
# To switch the pipeline to real GPT-4o-mini:
#   1. npm install openai
#   2. set USE_OPENAI = true at the top of services/agentPipeline.js
#   3. set OPENAI_API_KEY below
# OPENAI_API_KEY=sk-...
